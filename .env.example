APP_NAME="Event Pulse"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# ── Production (obligatoire) ──────────────────────────────────────────────
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://votre-domaine.com
# SESSION_SECURE_COOKIE=true
# SESSION_ENCRYPT=true
# LOG_LEVEL=warning
# TRUSTED_PROXIES=*
# Cron serveur (planificateur Laravel — dates vitrine) :
# * * * * * cd /chemin/event-pulse && php artisan schedule:run >> /dev/null 2>&1

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Devise — franc congolais (Congo)
EVENTPULSE_CURRENCY=CDF
EVENTPULSE_CURRENCY_SYMBOL=FC
EVENTPULSE_CURRENCY_NAME="Franc congolais"
EVENTPULSE_CURRENCY_DECIMALS=0
EVENTPULSE_PUBLICATION_FEE=25000
EVENTPULSE_REQUIRE_PUBLICATION_PAYMENT=false
EVENTPULSE_ENABLE_SEATED_PLACEMENT=false

# Compte Event Pulse — frais de publication (Mobile Money uniquement)
EVENTPULSE_PLATFORM_NAME="Event Pulse"
EVENTPULSE_MOBILE_PROVIDER=mpesa
EVENTPULSE_MOBILE_PHONE=0699999999

# Compte organisateur vitrine (contact@eventpulse.cd) — obligatoire au premier seed en production
EVENTSEEDER_ORGANIZER_PASSWORD=Ksh@EventPulse2026!
