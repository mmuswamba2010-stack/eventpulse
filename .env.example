APP_NAME="Event Pulse"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# ── Production (obligatoire) ──────────────────────────────────────────────
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://votre-domaine.com
# SESSION_SECURE_COOKIE=true
# SESSION_ENCRYPT=true
# LOG_LEVEL=warning
# TRUSTED_PROXIES=*
# Cron serveur (planificateur Laravel — dates vitrine) :
# * * * * * cd /chemin/event-pulse && php artisan schedule:run >> /dev/null 2>&1

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# En local et sur AlwaysData (sans worker) : sync envoie les e-mails immédiatement.
QUEUE_CONNECTION=sync

# Cron URL secours (GET /internal/cron/schedule/{token}) si crontab SSH indisponible
EVENTPULSE_CRON_TOKEN=

# Clé API AlwaysData (Profil → Tokens) pour scripts d'automatisation cron
# ALWAYSDATA_API_KEY=

# Modération organisateurs (false = accès immédiat à l'inscription)
EVENTPULSE_ORGANIZER_MODERATION=false

# Paiement simulé (false = confirmation via intégrateur de paiement)
EVENTPULSE_PAYMENT_SIMULATION=true
EVENTPULSE_WEBHOOK_SECRET=

# Google Search Console — code content= de la balise meta (sans guillemets)
# GOOGLE_SITE_VERIFICATION=

# Version des conditions organisateur (incrémenter si le texte change)
# EVENTPULSE_ORGANIZER_TERMS_VERSION=1.0

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

APP_URL=http://127.0.0.1:8000

# Connexion sociale — Google / Facebook (OAuth)
# Google Cloud Console → Identifiants → URI de redirection autorisée : ${APP_URL}/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
# Meta for Developers → Facebook Login → URI de redirection OAuth valides
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"

# ── E-mail local (Gmail) — mot de passe d'application Google requis ──
# https://myaccount.google.com/apppasswords
# Sans MAIL_PASSWORD, Laravel bascule automatiquement sur le driver log (hors production).
MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# ── E-mail production (AlwaysData) ──
# MAIL_MAILER=sendmail
# MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -t -i"
# MAIL_FROM_ADDRESS="eventpulse@alwaysdata.net"
# MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Devise — franc congolais (Congo)
EVENTPULSE_CURRENCY=CDF
EVENTPULSE_CURRENCY_SYMBOL=FC
EVENTPULSE_CURRENCY_NAME="Franc congolais"
EVENTPULSE_CURRENCY_DECIMALS=0
EVENTPULSE_USD_ENABLED=true
EVENTPULSE_CDF_PER_USD=2250
EVENTPULSE_PUBLICATION_FEE=22500
EVENTPULSE_REQUIRE_PUBLICATION_PAYMENT=false
EVENTPULSE_ENABLE_SEATED_PLACEMENT=false

# Plateforme — frais de publication (intégrateur à venir)
EVENTPULSE_PLATFORM_NAME="Event Pulse"
EVENTPULSE_PHONE_COUNTRY_CODE=+243
EVENTPULSE_PHONE_PLACEHOLDER=+243 81 234 5678

# Compte organisateur vitrine (contact@eventpulse.cd) — obligatoire au premier seed en production
EVENTSEEDER_ORGANIZER_PASSWORD=Ksh@EventPulse2026!
